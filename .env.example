CONTENT_SOURCE=local
# CONTENT_SOURCE=strapi
# CONTENT_SOURCE=snapshot

# Projects source is independent of article CONTENT_SOURCE. Default local.
PROJECTS_CONTENT_SOURCE=local
# PROJECTS_CONTENT_SOURCE=strapi
# PROJECTS_CONTENT_SOURCE=snapshot

# Services source is independent of articles/projects. Default local.
SERVICES_CONTENT_SOURCE=local
# SERVICES_CONTENT_SOURCE=strapi
# SERVICES_CONTENT_SOURCE=snapshot

# Prices source is independent. Default local.
PRICES_CONTENT_SOURCE=local
# PRICES_CONTENT_SOURCE=strapi
# PRICES_CONTENT_SOURCE=snapshot

# Required when CONTENT_SOURCE / PROJECTS_CONTENT_SOURCE / SERVICES_CONTENT_SOURCE / PRICES_CONTENT_SOURCE = strapi
# STRAPI_URL=http://127.0.0.1:1337
# STRAPI_TOKEN=
# STRAPI_TIMEOUT_MS=8000
